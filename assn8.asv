for i = 1:6

    I = im2double(imread(filenames(i)));

    if use_interactive_masks
        [poly_x, poly_y] = getPolygonForMask(I);

        fprintf('\ncoords for image %d:\n', i);
        fprintf('poly_x_all{%d} = %s;\n', i, mat2str(poly_x, 8));
        fprintf('poly_y_all{%d} = %s;\n\n', i, mat2str(poly_y, 8));
    else
        poly_x = poly_x_all{i};
        poly_y = poly_y_all{i};
    end

    mask = poly2mask(poly_x, poly_y, size(I, 1), size(I, 2));

    radius = radii(i);
    bokeh_shape = fspecial('disk', radius);

    result = method3(I, mask, bokeh_shape);

    figure;
    montage({I, result}, 'Size', [1, 2]);
    title("img" + i + ": original and Method 3 bokeh, radius = " + radius);

end


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% These are the functions that implement bokeh
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

function result = method1(I, mask, filter)

    mask = im2double(mask);

    if size(mask, 3) == 1 && size(I, 3) == 3
        mask = repmat(mask, [1, 1, 3]);
    end

    I_blur = imfilter(I, filter, 'replicate');
    result = I_blur .* (1 - mask) + I .* mask;

    result = min(max(result, 0), 1);

end


function result = method2(I, mask, filter)

    mask = im2double(mask);

    if size(mask, 3) == 1 && size(I, 3) == 3
        mask = repmat(mask, [1, 1, 3]);
    end

    bg = I .* (1 - mask);
    bg_blur = imfilter(bg, filter, 'replicate');
    result = bg_blur .* (1 - mask) + I .* mask;

    result = min(max(result, 0), 1);

end


function result = method3(I, mask, filter)

    mask = im2double(mask);

    filter = filter ./ sum(filter(:));

    %1 for background 0 for foreground
    bg_mask = 1 - mask;

    if size(I, 3) == 1

        bg = I .* bg_mask;

        numerator = imfilter(bg, filter, 'replicate');
        denominator = imfilter(bg_mask, filter, 'replicate');

        bg_blur = numerator ./ denominator;

        bg_blur(isnan(bg_blur)) = 0;
        bg_blur(isinf(bg_blur)) = 0;

        result = bg_blur .* bg_mask + I .* mask;

    else

        mask3 = repmat(mask, [1, 1, size(I, 3)]);
        bg_mask3 = repmat(bg_mask, [1, 1, size(I, 3)]);

        bg = I .* bg_mask3;

        numerator = imfilter(bg, filter, 'replicate');
        denominator = imfilter(bg_mask, filter, 'replicate');
        denominator3 = repmat(denominator, [1, 1, size(I, 3)]);

        bg_blur = numerator ./ denominator3;

        bg_blur(isnan(bg_blur)) = 0;
        bg_blur(isinf(bg_blur)) = 0;

        result = bg_blur .* bg_mask3 + I .* mask3;

    end

    result = min(max(result, 0), 1);

end


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Below are helper functions.  You DO NOT NEED TO MODIFY
% any of the code below.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

function [poly_x, poly_y] = getPolygonForMask(im)
    % Asks user to draw polygon around input image.  
    disp('Draw polygon around foreground object in clockwise order, q to stop');
    fig = figure; hold off; imagesc(im); axis image;
    poly_x = [];
    poly_y = [];
    while 1
        figure(fig)
        [x, y, b] = ginput(1);
        if b == 'q'
            break;
        end
        poly_x(end + 1) = x;
        poly_y(end + 1) = y;
        hold on; plot(poly_x, poly_y, '*-');
    end
    close(fig);
end

